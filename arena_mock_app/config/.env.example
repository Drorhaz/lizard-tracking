# =============================================================================
# Head Pose Detection Application Configuration
# =============================================================================
# Copy this file to .env and update the values for your setup

# -----------------------------------------------------------------------------
# MODEL CONFIGURATION
# -----------------------------------------------------------------------------

# Path to the YOLO pose detection model file (.pt)
# This is the trained model that detects head poses
MODEL_PATH=lizard-tracking/output/models/head_pose/best.pt

# Minimum confidence threshold for detections (0.0 to 1.0)
# Lower values = more detections but less accurate
# Higher values = fewer detections but more accurate
# Recommended: 0.2 for development, 0.5 for production
CONFIDENCE_THRESHOLD=0.2


# -----------------------------------------------------------------------------
# VIDEO INPUT CONFIGURATION
# -----------------------------------------------------------------------------

# Path to the video file to process
VIDEO_PATH=lizard-tracking/output/models/arena_mock_app/videos/top_20250916T150021.mp4

# Processing frame rate (frames per second)
# Lower values = slower but more stable
# Higher values = faster but may drop frames
PROCESSING_FPS=60


# -----------------------------------------------------------------------------
# OUTPUT CONFIGURATION
# -----------------------------------------------------------------------------

# Directory where detection results will be saved
# Results include: CSVs, plots, metrics, clean frames, labels, and previews
OUTPUT_DIR=../output/detections

# Save clean frames (NO drawings) + labels for training/annotation
# These go to: labeled_frames/ (clean images) + labels/ (YOLO txt)
# Use these with tools/preview_labels.py or labeler/ for annotation
# Set to 0 to disable
SAVE_EVERY_N_FRAMES=10

# Save preview frames (WITH drawings) for visual inspection
# These go to: preview_frames/ (annotated images showing detections)
# Higher value = less disk space, lower = more visual feedback
# Set to 0 to disable
SAVE_EVERY_N_PREVIEWS=30

# Enable verbose console logging (true/false)
# When enabled, prints detailed detection info to console
# Useful for debugging, but can be noisy
VERBOSE=false

# Detection IOU threshold (0.0 to 1.0)
# Intersection over Union threshold for Non-Maximum Suppression
# Lower = more detections kept, Higher = more aggressive filtering
DETECTION_IOU=0.5

# Detection image size (pixels)
# YOLO will resize frames to this size for detection
# Common values: 320, 640, 1280. Higher = more accurate but slower
DETECTION_IMGSZ=640


# -----------------------------------------------------------------------------
# BEHAVIORAL ANALYSIS CONFIGURATION (Advanced)
# -----------------------------------------------------------------------------

# Arena processing methodology
# Options: 'rotation', 'calibration'
# 'rotation' (RECOMMENDED): Simple approach - rotates video so target is always on right edge
#                           Good for most users, easier setup, works with any edge
# 'calibration': Advanced approach - uses edge-specific calculations, supports partial edge coverage
#                For complex setups (e.g., screen covers only 50% of top edge)
ARENA_METHOD=rotation

# Target line position for behavioral analysis
# Options: 'right', 'left', 'top', 'bottom'
# 'right' means the screen/target is on the right edge
TARGET_LINE=right

# Note on rotation method: Video frames are automatically rotated so target is always on right edge
# This simplifies all distance and behavioral calculations
# You'll see the rotated view in the UI (matches what algorithm sees)

# Target coverage (for calibration method only, 0.0 to 1.0)
# Fraction of edge covered by target/screen
# 1.0 = entire edge, 0.5 = half the edge (centered), etc.
# Only used when ARENA_METHOD=calibration
TARGET_COVERAGE=1.0

# Calibration file path (for calibration method only)
# Path to saved calibration file (.json or .pkl)
# If not provided, system will prompt for calibration on first run
# Only used when ARENA_METHOD=calibration
# CALIBRATION_FILE=../output/arena_calibration.json

# Distance threshold for "near" classification (0.0 to 1.0)
# Fraction of frame width - e.g., 0.20 = within 20% of target
NEAR_MAX=0.20

# Distance threshold for "middle buffer" zone (0.0 to 1.0)
# Fraction of frame width - e.g., 0.30 = 20-30% from target
MIDDLE_MAX=0.30

# Approach/advance movement threshold (normalized)
# Sensitivity for detecting movement toward target
# Lower = more sensitive, Higher = less sensitive
ADVANCE_THRESHOLD=0.002

# Retreat movement threshold (normalized)
# Sensitivity for detecting movement away from target
RETREAT_THRESHOLD=0.002

# X-axis movement threshold (normalized, fraction of frame width)
# Minimum horizontal movement to be considered significant
X_DIR_THRESH_NORM=0.01

# Y-axis movement threshold (normalized, fraction of frame height)
# Minimum vertical movement to be considered significant
Y_DIR_THRESH_NORM=0.01

# Head-only movement threshold (normalized, fraction of diagonal)
# Detects small head movements without body locomotion
# Used for "wiggling" or "orienting" behaviors
HEAD_ONLY_THRESH_NORM=0.005

# Body movement threshold (normalized, fraction of diagonal)
# Detects full-body locomotion
# Movements above this are considered walking/running
BODY_MOVE_THRESH_NORM=0.010

# Lookback window for handling missing detections (frames)
# Number of previous frames to check when current frame has no detection
LOOKBACK_WINDOW=5


# -----------------------------------------------------------------------------
# SIMPLE BEHAVIOR DETECTION (Fallback)
# -----------------------------------------------------------------------------

# Minimum consecutive frames to classify as "moving"
MIN_MOVING_FRAMES=3

# Distance threshold for "stopped" classification (pixels)
# If movement is less than this, animal is considered stationary
STOP_THRESHOLD=300.0

# Minimum consecutive frames to classify as "stationary"
MIN_STATIONARY_FRAMES=3


# -----------------------------------------------------------------------------
# MESSAGE THROTTLING
# -----------------------------------------------------------------------------

# Minimum time between repeated identical messages (seconds)
# Prevents spam when the same behavioral state repeats frequently
# Example: "resting: resting — far @ LEFTSIDE" won't repeat for 3 seconds
# Set to 0 to disable throttling (show all messages)
# Recommended: 2-5 seconds
MESSAGE_THROTTLE_SECONDS=3.0


# -----------------------------------------------------------------------------
# WEB SERVER CONFIGURATION
# -----------------------------------------------------------------------------

# Flask server host (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
SERVER_HOST=0.0.0.0

# Flask server port
SERVER_PORT=8078

# Server debug mode (true/false)
# WARNING: Only enable for development, not production
SERVER_DEBUG=false

# Video stream frame rate (FPS for web UI)
# Controls how fast frames are sent to browser
STREAM_FPS=15

# JPEG quality for video stream (1-100)
# Higher = better quality but more bandwidth
JPEG_QUALITY=85

SAVE_VIDEO_WITH_OVERLAYS=true
OUTPUT_VIDEO_FPS=15.0

# -----------------------------------------------------------------------------
# VIDEO OUTPUT WITH OVERLAYS
# -----------------------------------------------------------------------------

# Output video FPS (independent of processing speed)
OUTPUT_VIDEO_FPS=15.0
