# =============================
# Video Pose Pipeline — CONFIG
# =============================
# MODE: INFER_LIVE | LABELS_ONLY | PLAYBACK_CACHE
MODE=LABELS_ONLY

# Path to video file
VIDEO_PATH=/absolute/path/to/video.mp4

# Ultralytics model: either MODEL_PATH or MODEL_DIR (search best*.pt)
MODEL_PATH=
MODEL_DIR=output/models/head_pose

# Model device: "cuda:0" for GPU, "cpu" for CPU
MODEL_DEVICE=cuda:0
# Use half precision (FP16) on GPU? (ignored on CPU)
MODEL_HALF=true

# Output base directory for this run (frames, labels, csv)
OUTPUT_DIR=output/detections

# Analyze every Nth frame (1 = every frame)
PROCESS_EVERY_N=1

# Save a labeled frame image every N analyzed frames (0 to disable)
LABEL_EVERY_N=20

# Desktop preview toggle (cv2.imshow). Keep FALSE on servers/headless.
PREVIEW=false
WINDOW_NAME=Pose Overlay
FPS_LIMIT=0

# Browser preview (Flask MJPEG). Enable this on servers if you want web view.
WEB_PREVIEW=false
WEB_HOST=0.0.0.0
WEB_PORT=8765

# YOLO inference params
IMG_SIZE=640
CONF_THRESH=0.25
IOU_THRESH=0.50

# Maximum preview width for saved images
PREVIEW_MAX_W=900
